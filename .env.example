# Copy to .env for local runs. Never commit .env.
# In CI and deployed environments these come from the company secret manager.
#
# LLM for the agent service (E5; Groq, OpenAI-compatible). Locally these go in
# services/agent-service/.env:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
#
# Verifier SDK (docs/verifier.md), not used yet:
# VERIFIER_API_KEY=
