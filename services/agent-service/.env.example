# Copy to .env (git-ignored) for local runs: `npm run dev` loads it.
# In deployed environments these come from the company secret manager.

# Required. Groq API key (https://console.groq.com). Never commit it.
LLM_API_KEY=

# Optional, shown with their defaults.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# PORT=8090
# Folder with the catalog export (catalog.json, catalog.prompt.md).
# CATALOG_DIR=../../frontend/src/app/catalog/generated
