{
  "name": "copilot-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted CopilotKit runtime (E5-S4): the browser-facing endpoint that hosts the trading agent.",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@copilotkit/runtime": "1.66.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
